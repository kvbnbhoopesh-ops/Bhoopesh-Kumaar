class Solution {
    public String customSortString(String order, String s) {
        int[] charCounts = new int[26];
        for (int i = 0; i < s.length(); i++) {
            charCounts[s.charAt(i) - 'a']++;
        }
        StringBuilder sortedResult = new StringBuilder();
        for (int i = 0; i < order.length(); i++) {
            char currentChar = order.charAt(i);
            int countIndex = currentChar - 'a';
            
            while (charCounts[countIndex] > 0) {
                sortedResult.append(currentChar);
                charCounts[countIndex]--;
            }
        }
        for (int i = 0; i < 26; i++) {
            while (charCounts[i] > 0) {
                sortedResult.append((char) (i + 'a'));
                charCounts[i]--;
            }
        }
        return sortedResult.toString();
    }
} 
